    "prisma:migrate": "prisma migrate dev",
    "fix:player-ids": "tsx src/scripts/fixPlayerIds.ts",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "5.22.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "prisma": "5.22.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
