{
  "name": "@gamble-game/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "prisma db push --skip-generate --accept-data-loss && node dist/server.js",
